<?xml version="1.0" encoding="utf-8"?>
<!-- Lets the share sheet show TinyKit's pinned apps in its top row (see ShareTo). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="io.github.order52.tinykit.ShareTo">
        <data android:mimeType="*/*" />
        <category android:name="io.github.order52.tinykit.SHARE" />
    </share-target>
</shortcuts>
