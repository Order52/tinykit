<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App pickers list every installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Update notification, only when "Check for updates on start" is turned on (asked then). -->

    <!-- Only used by "Check for updates" and the public IP on Network info. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network info page reads the active connection's addresses and Wi-Fi state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Start Shizuku by asking Termux to run the shizuku-termux command (granted by the user). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Unused apps and recent access read usage stats; the appop is granted through Shizuku. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Free up RAM without Shizuku on Android 13 and older (closes only cached apps). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Offer to send the details of a crash, right when it happens (asked once, only if you agree). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Block new apps' internet the moment they are installed: a quiet foreground service, only while
         allow list mode or a block list is in use, started again after a restart. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Toggles and tiles keep working with Shizuku off: granted once through Shizuku. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".TinyKitApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShizukuTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_shizuku"
            android:label="@string/tile_shizuku"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Active tile: EMUI never binds passive ones. Refreshed when Shizuku starts or stops. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".ScreenshotTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_screenshot"
            android:label="@string/tile_screenshot"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The rest of the Quick Settings tiles. All share one base class. -->
        <service android:name=".Tiles$Caffeine" android:exported="true" android:icon="@drawable/ic_tile_caffeine" android:label="@string/tile_caffeine" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$DevOptions" android:exported="true" android:icon="@drawable/ic_tile_dev" android:label="@string/tile_developer_options" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$UsbDebug" android:exported="true" android:icon="@drawable/ic_tile_usb" android:label="@string/tile_usb_debugging" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$KillForeground" android:exported="true" android:icon="@drawable/ic_tile_kill" android:label="@string/tile_close_app" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$SensorsOff" android:exported="true" android:icon="@drawable/ic_tile_sensors" android:label="@string/tile_sensors_off" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$Timeout" android:exported="true" android:icon="@drawable/ic_tile_timeout" android:label="@string/tile_screen_timeout" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$Grayscale" android:exported="true" android:icon="@drawable/ic_tile_grayscale" android:label="@string/tile_grayscale" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$AdBlock" android:exported="true" android:icon="@drawable/ic_tile_adblock" android:label="@string/tile_ad_block_dns" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$HideDev" android:exported="true" android:icon="@drawable/ic_tile_hidedev" android:label="@string/tile_hide_dev_options" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$ExtraDim" android:exported="true" android:icon="@drawable/ic_tile_dim" android:label="@string/tile_extra_dim" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$ClearCaches" android:exported="true" android:icon="@drawable/ic_tile_cache" android:label="@string/tile_clear_caches" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$MicCam" android:exported="true" android:icon="@drawable/ic_tile_miccam" android:label="@string/tile_mic_camera_off" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$Firewall" android:exported="true" android:icon="@drawable/ic_tile_firewall" android:label="@string/tile_internet_block" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$HwOverlays" android:exported="true" android:icon="@drawable/ic_tile_overlays" android:label="@string/tile_hw_overlays_off" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$ForceDark" android:exported="true" android:icon="@drawable/ic_tile_forcedark" android:label="@string/tile_force_dark" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$WorkProfile" android:exported="true" android:icon="@drawable/ic_tile_work" android:label="@string/tile_work_profile" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$Mixer" android:exported="true" android:icon="@drawable/ic_nav_system" android:label="@string/tile_mixer" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- What a pinned work-app shortcut starts: no screen, it unfreezes and opens the app. -->
        <activity
            android:name=".WorkOpen"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Pinned apps in the share sheet. Off until an app is pinned, so the sheet is untouched otherwise. -->
        <activity
            android:name=".ShareTo"
            android:exported="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/share_pinned"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Home screen widget: one tap frees RAM and clears app caches. -->
        <receiver android:name=".BoostWidget" android:exported="false" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/boost_widget" />
        </receiver>
        <service android:name=".Tiles$Memory" android:exported="true" android:icon="@drawable/ic_tile_ram" android:label="@string/tile_free_ram" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$ScreenRecord" android:exported="true" android:icon="@drawable/ic_tile_record" android:label="@string/tile_screen_record" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <!-- "Run in the background": off unless the user turns it on, and then running only while a
             tool needs it (new apps for the internet block or Fake permissions, and Shut Up). -->
        <service
            android:name=".BackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listens for newly installed apps to block their internet access, watches which app is open to hide developer options from the apps the user chose, and freezes the work-profile apps the user chose when the screen has been off for a while" />
        </service>

        <!-- Starts that service again after a restart or an update of TinyKit. -->
        <receiver android:name=".StartReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Termux's reply to a tile tap. -->
        <receiver
            android:name=".ShizukuTile$Result"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
