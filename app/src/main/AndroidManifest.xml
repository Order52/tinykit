<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App pickers list every installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Update notification, only when "Check for updates on start" is turned on (asked then). -->

    <!-- Only used by "Check for updates" and the public IP on Network info. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network info page reads the active connection's addresses and Wi-Fi state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Start Shizuku by asking Termux to run the shizuku-termux command (granted by the user). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Unused apps and recent access read usage stats; the appop is granted through Shizuku. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Free up RAM without Shizuku on Android 13 and older (closes only cached apps). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Offer to send the details of a crash, right when it happens (asked once, only if you agree). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Toggles and tiles keep working with Shizuku off: granted once through Shizuku. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".TinyKitApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShizukuTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_shizuku"
            android:label="Shizuku"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Active tile: EMUI never binds passive ones. Refreshed when Shizuku starts or stops. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".ScreenshotTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_screenshot"
            android:label="Screenshot"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The rest of the Quick Settings tiles. All share one base class. -->
        <service android:name=".Tiles$Caffeine" android:exported="true" android:icon="@drawable/ic_tile_caffeine" android:label="Caffeine" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$DevOptions" android:exported="true" android:icon="@drawable/ic_tile_dev" android:label="Developer options" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$UsbDebug" android:exported="true" android:icon="@drawable/ic_tile_usb" android:label="USB debugging" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$KillForeground" android:exported="true" android:icon="@drawable/ic_tile_kill" android:label="Close app" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$SensorsOff" android:exported="true" android:icon="@drawable/ic_tile_sensors" android:label="Sensors off" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$Timeout" android:exported="true" android:icon="@drawable/ic_tile_timeout" android:label="Screen timeout" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$Grayscale" android:exported="true" android:icon="@drawable/ic_tile_grayscale" android:label="Grayscale" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$AdBlock" android:exported="true" android:icon="@drawable/ic_tile_adblock" android:label="Ad-block DNS" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$HideDev" android:exported="true" android:icon="@drawable/ic_tile_hidedev" android:label="Hide dev options" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$ExtraDim" android:exported="true" android:icon="@drawable/ic_tile_dim" android:label="Extra dim" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$ClearCaches" android:exported="true" android:icon="@drawable/ic_tile_cache" android:label="Clear caches" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$MicCam" android:exported="true" android:icon="@drawable/ic_tile_miccam" android:label="Mic &amp; camera off" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$HwOverlays" android:exported="true" android:icon="@drawable/ic_tile_overlays" android:label="HW overlays off" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".Tiles$ForceDark" android:exported="true" android:icon="@drawable/ic_tile_forcedark" android:label="Force dark" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <!-- Home screen widget: one tap frees RAM and clears app caches. -->
        <receiver android:name=".BoostWidget" android:exported="false" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/boost_widget" />
        </receiver>
        <service android:name=".Tiles$Memory" android:exported="true" android:icon="@drawable/ic_tile_ram" android:label="Free RAM" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".Tiles$ScreenRecord" android:exported="true" android:icon="@drawable/ic_tile_record" android:label="Screen record" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <!-- Blocks a newly installed app when the internet firewall is in allow list mode. -->
        <receiver android:name=".NewAppReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Termux's reply to a tile tap. -->
        <receiver
            android:name=".ShizukuTile$Result"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
